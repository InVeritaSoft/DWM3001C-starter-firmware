# UWB Test Rig Configuration - Windows
# Updated with detected ports

# Node A serial port
NODE_A_PORT=COM17
# Node B serial port
NODE_B_PORT=COM18

# Baud rate for RS-485 communication
BAUDRATE=115200

# Serial communication timeout (seconds)
SERIAL_TIMEOUT=2.0

# Test Configuration
TEST_POLL_INTERVAL_SECONDS=2
TEST_DEFAULT_DURATION_SECONDS=60

# Web Server Configuration
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_DEBUG=false

# Swagger API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs
