# DWM3001C Orchestrator Configuration - Windows
# ================================================

# Communication Mode Selection
# ----------------------------
# COMM_MODE controls which serial interface to use:
#   "jlink"  - J-Link CDC UART (built-in USB, no external wiring needed) [DEFAULT]
#   "rs485"  - CH340 USB-to-RS485 adapters (external via RJ45 cable)
#
# When switching modes, you may also need to update firmware pin configuration
# in Src/custom_board.h:
#   - J-Link mode: RX=GPIO15, TX=GPIO19 (built-in)
#   - RS-485 mode: RX=GPIO15, TX=GPIO14 (J10 connector pins)
COMM_MODE=jlink

# J-Link CDC UART Ports (used when COMM_MODE=jlink)
# These are the built-in USB serial ports on the DWM3001CDK boards
JLINK_NODE_A_PORT=COM15
JLINK_NODE_B_PORT=COM11

# RS-485 Ports (used when COMM_MODE=rs485)
# These are the CH340 USB-to-Serial adapters connected via RS-485
RS485_NODE_A_PORT=COM20
RS485_NODE_B_PORT=COM19

# Legacy port settings (override mode-based selection if set)
# Leave commented to use COMM_MODE-based port selection
#NODE_A_PORT=COM15
#NODE_B_PORT=COM11

# Serial communication settings
BAUDRATE=57600
TIMEOUT=5

# Web server settings
PORT=3000
HOST=0.0.0.0
