# UWB Test Orchestrator - Linux Environment Configuration
# This file is automatically loaded on Linux systems
# Settings here override config/settings.yaml

# Serial Port Configuration (RS-485)
# Linux serial ports: /dev/ttyUSB0, /dev/ttyUSB1, /dev/ttyACM0, etc.
# Use 'ls -la /dev/ttyUSB* /dev/ttyACM*' to discover available ports
# Currently detected: /dev/ttyUSB0, /dev/ttyAMA10
# 
# NOTE: If you have two separate USB-to-RS485 adapters, use different ports
# If both nodes are on the same RS-485 bus, you may need to use the same port
# or configure your RS-485 setup accordingly
SERIAL_NODE_A_PORT=/dev/ttyUSB0
SERIAL_NODE_B_PORT=/dev/ttyUSB1
SERIAL_BAUDRATE=115200
SERIAL_TIMEOUT=5

# Web Server Configuration
WEB_PORT=5000
WEB_HOST=0.0.0.0

# Test Configuration (optional - defaults from settings.yaml if not set)
# TEST_CHANNEL=5
# TEST_DATA_RATE=6m8
# TEST_PREAMBLE_LEN=128
# TEST_PAYLOAD_LEN=64
# TEST_TX_POWER_IDX=5
# TEST_PKT_RATE_HZ=100
# TEST_POLL_INTERVAL_SECONDS=2
# TEST_DEFAULT_DURATION_SECONDS=30

# Debug Flags
# DEBUG_RS485=true
