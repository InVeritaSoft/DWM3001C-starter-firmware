{
  "name": "uwb-test-orchestrator",
  "version": "1.0.0",
  "description": "RPi5 orchestrator for UWB DWM3001C test rig",
  "main": "src/orchestrator/main.js",
  "type": "module",
  "scripts": {
    "start": "node src/orchestrator/main.js",
    "dev": "node --watch src/orchestrator/main.js",
    "web": "node src/web/server.js",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "start:win": "node src/orchestrator/main.js",
    "start:linux": "node src/orchestrator/main.js",
    "start:windows": "cmd /c start-windows.bat",
    "dev:windows": "cmd /c start-windows-dev.bat",
    "web:windows": "cmd /c start-windows-web.bat",
    "list-ports": "node scripts/list-ports.js",
    "test-ping": "node scripts/test-ping.js",
    "diagnose-uart": "node scripts/diagnose-uart.js",
    "diagnose-complete": "node scripts/diagnose-complete.js",
    "verify-flash": "node scripts/verify-flash.js",
    "test-rs485-tx": "node scripts/test-rs485-tx.js",
    "test-uwb-commands": "node scripts/test-uwb-commands.js",
    "verify-communication": "node scripts/verify-communication.js",
    "test-serial": "node scripts/test-serial-connection.js"
  },
  "keywords": [
    "uwb",
    "dwm3001c",
    "test-rig",
    "raspberry-pi"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "serialport": "^12.0.0",
    "csv-writer": "^1.6.0",
    "csv-parser": "^3.0.0",
    "js-yaml": "^4.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "cors": "^2.8.5"
  }
}

